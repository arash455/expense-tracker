# Copy this file to ".env" and fill in your own values.
# (.env is ignored by git, so your secrets never get pushed to GitHub.)

# PostgreSQL connection string. Copy it from your Neon dashboard. It looks like:
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# (Neon shows "sslmode=require"; changing it to "sslmode=verify-full" removes a harmless warning.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expenses

# Any long random string. Used to sign login tokens. Keep it secret!
JWT_SECRET=change-me-to-a-long-random-string

# Whoever registers (or already registered) with this email becomes admin.
ADMIN_EMAIL=you@example.com

# Your frontend URL(s), comma separated. Leave empty during local development.
# Example: https://my-expenses.netlify.app
FRONTEND_URL=

PORT=3000
